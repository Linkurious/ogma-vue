{
  "name": "@linkurious/ogma-vue",
  "version": "1.0.1",
  "private": false,
  "description": "Vue 3 wrapper for Ogma",
  "license": "Apache-2.0",
  "author": "Linkurious SAS",
  "files": [
    "dist/ogma-vue.js",
    "dist/ogma-vue.umd.cjs",
    "dist/**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/ogma-vue.js",
  "module": "dist/ogma-vue.js",
  "types": "dist/types/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/main.d.ts",
      "import": "./dist/ogma-vue.js",
      "require": "./dist/ogma-vue.umd.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite -c demo/vite.config.ts",
    "build": "vite build",
    "test": "vitest -c tests/unit/vitest.config.ts",
    "test:unit": "vitest run -c tests/unit/vitest.config.ts  --reporter=junit --reporter=default --outputFile reports/unit/junit-test-results.xml",
    "lint:ci": "mkdir -p reports/lint && oxlint -f checkstyle > reports/checkstyle.xml; oxlint -f junit > reports/lint/junit-lint-results.xml",
    "lint": "oxlint",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "predocs:publish": "npm run docs:build",
    "docs:publish": "gh-pages -t --nojekyll -d docs/.vitepress/dist",
    "upload": "npm run docs:publish",
    "prepare": "git config core.hooksPath .githooks || true",
    "postversion": "sync_versions",
    "help": "vue-cli-service help build",
    "prepack": "node scripts/clean-package.js",
    "bump:patch": "npm version patch --no-git-tag-version",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@linkurious/code-tools": "0.2.0",
    "@linkurious/eslint-config-ogma": "3.0.0-beta",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "^2.4.1",
    "canvas": "3.2.3",
    "concurrently": "^7.1.0",
    "gh-pages": "6.1.1",
    "happy-dom": "^20.5.0",
    "jsdoc-to-markdown": "^8.0.0",
    "jsdom": "^22.1.0",
    "naive-ui": "2.45.3",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "rollup-plugin-typescript2": "^0.36.0",
    "typescript": "5.5.3",
    "vite": "8.3.1",
    "vite-plugin-dts": "^3.7.0",
    "vitepress": "^1.0.0-rc.32",
    "vitest": "5.0.2"
  },
  "peerDependencies": {
    "@linkurious/ogma": ">=5.3.8",
    "vue": "3.4.7"
  }
}
